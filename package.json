{
  "name": "soundclud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Space-Cadet0/SoundClud.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "check:hygiene": "node ./scripts/check-hygiene.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspaces run typecheck",
    "test": "vitest run",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "verify": "npm run check:hygiene && npm run typecheck && npm test && npm run check:rust"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

{
  "schemaVersion": 1,
  "component": "mpv",
  "description": "Standalone macOS 11+ (Monterey x86_64 and Apple Silicon arm64) mpv binary archives verified via SHA-256 with zero Homebrew or Python runtime dependency.",
  "minimumMacosDeploymentTarget": "11.0",
  "heosOnlyRequiresMpv": false,
